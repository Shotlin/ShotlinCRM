# PostgreSQL and Redis are required in every environment.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/shotlin
REDIS_URL=redis://127.0.0.1:6379

# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Generate with: openssl rand -base64 32. Changing this invalidates WhatsApp sessions.
WHATSAPP_AUTH_MASTER_KEY=

# Optional separate 32-byte key for AI provider credentials. Falls back to the
# WhatsApp key when omitted.
AI_CREDENTIAL_MASTER_KEY=

# Development-only convenience bootstrap. In production, omit this and run
# npm run auth:create-owner -- --email you@example.com --name "Your Name".
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Private S3-compatible object storage. MinIO is suitable for local development.
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=shotlin-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Meta Lead Ads
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
S3_MODE=s3
